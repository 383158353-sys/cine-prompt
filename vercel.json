{
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler?cinepath=/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 300,
      "includeFiles": "{server,shared}/**"
    }
  }
}
