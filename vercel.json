{
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 300,
      "includeFiles": "{server,shared}/**"
    }
  }
}
