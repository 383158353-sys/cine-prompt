AI_PROVIDER=compatible
AI_BASE_URL=https://api.lingkeai.ai/api/v1
AI_API_KEY=
# Required: exact model ID available in your aggregator account.
AI_MODEL=
# Optional: override the existing model selector buttons.
AI_MODEL_GEMINI=
AI_MODEL_GPT=
AI_MODEL_CLAUDE=
# Optional: model supporting /images/generations for style thumbnails.
AI_IMAGE_MODEL=
# prompt is broadly compatible; json_object requires provider support.
AI_JSON_MODE=prompt
AI_TIMEOUT_MS=180000
# Whole upstream JSON budget (UTF-8 bytes); tune to the actual provider limit.
AI_MAX_REQUEST_BYTES=4000000
# Logs only ingress/upstream byte counts and upstream status, never image/prompt/key data.
AI_REQUEST_DIAGNOSTICS=0
PORT=5173
# Gemini 官方 API 请改为：
# AI_PROVIDER=gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_MODEL=gemini-3.1-flash-lite
